# Local development uses files under .local. No cloud credentials are needed.
PORT=8080
# Click Continue locally when no Firebase config is set. This mode is disabled in production.
# Optional Photon-compatible place-search endpoint (no API key required).
# GEOCODING_URL=https://photon.komoot.io/api/
# On Cloud Run, configure these and use the attached service account.
# DATA_BACKEND=gcp
# GOOGLE_CLOUD_PROJECT=your-project
# PHOTO_BUCKET=your-private-photo-bucket
# FIREBASE_API_KEY=your-firebase-web-api-key
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_APP_ID=your-firebase-web-app-id
# For local Google sign-in testing, configure Application Default Credentials:
# gcloud auth application-default login
# GOOGLE_CLOUD_QUOTA_PROJECT=your-project
